# Database
DATABASE_URL=postgresql://user:password@localhost:5432/survai_pro

# NextAuth
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# OpenAI API
OPENAI_API_KEY=sk-

# Vercel Blob (storage)
BLOB_READ_WRITE_TOKEN=

# Optional: Local file storage fallback
STORAGE_TYPE=vercel_blob
# STORAGE_TYPE=local

# Environment
NODE_ENV=development

# Google Maps Platform (Geocoding, Street View Static, Maps Static, Places Autocomplete)
GOOGLE_MAPS_API_KEY=

# Social sign-in (buttons appear automatically when set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

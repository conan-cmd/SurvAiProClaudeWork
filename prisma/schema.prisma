generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String          @id @default(cuid())
  email                 String          @unique
  name                  String?
  password              String? // hashed via NextAuth
  emailVerified         DateTime?
  image                 String?

  organizationId        String
  organization          Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  role                  UserRole        @default(MEMBER)

  // When false, this user can draft proposals but must have them signed off by an
  // approver (OWNER/ADMIN) before they can be sent. Owners/admins always can send.
  canSendProposals      Boolean         @default(true)

  // Personal sign-off for proposals this user creates
  signOffName           String?
  headshotUrl           String?
  signatureImageUrl     String?

  // Connected Gmail for sending proposals from the user's own address (Tier 2).
  // The refresh token is encrypted at rest (lib/crypto).
  gmailAddress          String?
  gmailRefreshToken     String?

  surveysCreated        SiteSurvey[]    @relation("SurveyCreator")
  proposalsCreated      Proposal[]      @relation("ProposalCreator")
  ramsCreated           Rams[]          @relation("RamsCreator")

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([organizationId])
}

model Invite {
  id                    String          @id @default(cuid())
  organizationId        String
  organization          Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email                 String
  token                 String          @unique
  expiresAt             DateTime
  acceptedAt            DateTime?
  createdAt             DateTime        @default(now())

  @@index([organizationId])
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

// Sign-off state for a proposal drafted by a restricted (draft-only) user.
enum ApprovalStatus {
  NONE               // no review needed / never submitted
  PENDING            // submitted, waiting for an approver
  APPROVED           // signed off — ready to send
  CHANGES_REQUESTED  // approver asked for changes
}

model Organization {
  id                    String          @id @default(cuid())
  name                  String
  website               String?
  logoUrl               String?

  // Brand configuration
  brandColor            String          @default("#2563EB")
  secondaryColor        String          @default("#10B981")
  accentColor           String          @default("#0F172A")

  // Company details
  email                 String?
  phone                 String?
  mainServices          String? // JSON array
  areasCovered          String? // JSON array
  yearEstablished       Int?
  mainUSP               String?
  reviewCount           Int?          @default(0)
  whyChooseUs           String?
  proposalTone          ProposalTone  @default(PROFESSIONAL)

  // Reusable sections
  aboutUsSection        String?
  whyChooseUsSection    String?
  ourExperienceSection  String?
  ourApproachSection    String?

  // Standard T&Cs library, reused on every proposal (user-editable).
  // termsAndConditions = residential/default; termsCommercial falls back to it.
  termsAndConditions    String?
  termsCommercial       String?

  // YouTube channel for embedding similar-work videos in proposals
  youtubeChannelUrl     String?

  // Deposit rules JSON: {"residential":{"type":"PERCENT|FIXED|NONE","value":50},"commercial":{...}}
  depositRules          String?

  // Personal sign-off shown at the bottom of every proposal
  signOffName           String?
  headshotUrl           String?
  signatureImageUrl     String?

  // Which identity represents proposals by default: whose email/headshot/signature
  // shows and who is the reply-to/sender. CREATOR (the drafter) | USER (a fixed
  // person, e.g. the owner) | ORG (the organisation's own details).
  proposalIdentityMode   String  @default("CREATOR")
  proposalIdentityUserId String?

  // True once the first-run setup wizard is finished (or dismissed for good).
  onboardingComplete    Boolean         @default(false)

  // Stripe Connect: the firm's own connected account, so deposits pay them directly.
  stripeAccountId       String?
  stripeChargesEnabled  Boolean         @default(false)

  // Platform subscription billing (SurvAIPro charging the firm).
  stripeCustomerId      String?
  subscriptionId        String?
  subscriptionStatus    String?  // trialing | active | past_due | canceled | unpaid | incomplete...
  subscriptionPlan      String?  // "monthly" | "annual"
  currentPeriodEnd      DateTime?
  // Existing/comped accounts skip the paywall (backfilled true for all current orgs).
  billingExempt         Boolean         @default(false)
  // Free access granted by an access code (revocable). accessCodeId = which code.
  freeAccess            Boolean         @default(false)
  accessCodeId          String?
  // One of the first 100 firms — £49/mo locked in for life (vs £99 standard).
  isFoundingMember      Boolean         @default(false)
  // Bitcoin (Coinbase Commerce) annual payments — access is granted until this
  // date, independent of the Stripe subscription. cryptoLastChargeId dedupes
  // webhook retries so a paid year is never double-counted.
  cryptoAccessUntil     DateTime?
  cryptoLastChargeId    String?
  // Retention: reason captured at cancel, and a paused-until date (pause vs cancel).
  cancelReason          String?
  subscriptionPausedUntil DateTime?

  users                 User[]
  invites               Invite[]
  surveys               SiteSurvey[]
  proposals             Proposal[]
  templates             ProposalTemplate[]
  folders               Folder[]
  rams                  Rams[]
  documents             OrgDocument[]

  // When true, team members can view everyone's surveys/proposals (owners always can)
  membersViewAll        Boolean         @default(false)
  // Show GPS coordinates + what3words on the proposal cover
  showCoordinatesOnProposal Boolean     @default(true)

  // Referral programme
  referralCode          String?         @unique
  referredByCode        String?
  galleryPhotos         GalleryPhoto[]

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

enum ProposalTone {
  FRIENDLY
  PROFESSIONAL
  PREMIUM
  TECHNICAL
}

// Reusable best-work photos (before/afters), tagged so proposals can
// auto-include examples of similar past jobs.
model GalleryPhoto {
  id                    String          @id @default(cuid())
  organizationId        String
  organization          Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  fileUrl               String
  fileName              String
  fileSize              Int
  caption               String?
  tags                  String? // comma-separated service types, e.g. "roof cleaning, moss removal"

  createdAt             DateTime        @default(now())

  @@index([organizationId])
}

model SiteSurvey {
  id                    String          @id @default(cuid())
  organizationId        String
  organization          Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Client info
  clientName            String
  clientCompany         String?
  clientEmail           String?
  clientPhone           String?
  clientAddress         String
  latitude              Float?
  longitude             Float?
  what3words            String? // 3-word address derived from lat/lng
  // Saved fine-tuning of the site imagery so it restores on return (see SiteLocation).
  streetViewHeading     Float?  // Street View compass rotation (degrees)
  aerialZoom            Int?    // aerial static-map zoom level
  // Aerial area measurement: the drawn polygon (JSON [{lat,lng}]) + its area in m².
  areaPolygon           String?
  areaSqm               Float?
  // Multi-measurement markup: JSON [{ id, type:'area'|'line'|'note', points:[{lat,lng}], label? }].
  mapMeasurements       String?
  linearMeters          Float?  // total length of all 'line' measurements
  showMeasurementsOnProposal Boolean @default(true)

  // Survey details
  title                 String
  serviceType           String
  isResidential         Boolean
  clientPriorities      String?
  accessNotes           String?
  measurements          String?
  exclusions            String?
  // Exterior-cleaning prompts for the surveyor
  chemicalsRequired     String?  // e.g. sodium hypochlorite, biocide, softwash mix
  waterSupply           String?  // on-site tap? bring bowser? access/pressure notes

  // Content
  writtenDescription    String?
  photos                SurveyPhoto[]
  voiceNotes            VoiceNote[]
  transcripts           Transcript[]

  // Proposal linkage
  proposal              Proposal?
  rams                  Rams?

  // Optional folder for organising jobs (proposals follow their survey)
  folderId              String?
  folder                Folder?         @relation(fields: [folderId], references: [id], onDelete: SetNull)

  createdById           String?
  createdBy             User?           @relation("SurveyCreator", fields: [createdById], references: [id], onDelete: SetNull)

  status                SurveyStatus     @default(DRAFT)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([organizationId])
  @@index([status])
}

enum SurveyStatus {
  DRAFT
  SUBMITTED
  ARCHIVED
}

// Reusable company documents (insurance, certs, accreditations) that can be
// attached to proposal emails.
model OrgDocument {
  id                    String          @id @default(cuid())
  organizationId        String
  organization          Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                  String
  fileUrl               String
  fileType              String?
  fileSize              Int             @default(0)
  createdAt             DateTime        @default(now())

  @@index([organizationId])
}

model Folder {
  id                    String          @id @default(cuid())
  organizationId        String
  organization          Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                  String
  surveys               SiteSurvey[]
  createdAt             DateTime        @default(now())

  @@index([organizationId])
}

model SurveyPhoto {
  id                    String          @id @default(cuid())
  surveyId              String
  survey                SiteSurvey      @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  fileUrl               String
  fileName              String
  fileSize              Int
  caption               String?

  order                 Int             @default(0)
  isCoverImage          Boolean         @default(false)
  includeInProposal     Boolean         @default(true)
  internalOnly          Boolean         @default(false)

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([surveyId])
}

model VoiceNote {
  id                    String          @id @default(cuid())
  surveyId              String
  survey                SiteSurvey      @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  fileUrl               String
  fileName              String
  duration              Int // seconds

  transcript            Transcript?

  createdAt             DateTime        @default(now())

  @@index([surveyId])
}

model Transcript {
  id                    String          @id @default(cuid())
  voiceNoteId           String          @unique
  voiceNote             VoiceNote       @relation(fields: [voiceNoteId], references: [id], onDelete: Cascade)

  surveyId              String
  survey                SiteSurvey      @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  text                  String
  approved              Boolean         @default(false)

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([surveyId])
}

model ProposalTemplate {
  id                    String          @id @default(cuid())
  organizationId        String
  organization          Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name                  String          // Quick Quote, Consultative, Authority
  sections              String          // JSON array of section configs
  description           String?

  createdAt             DateTime        @default(now())

  @@index([organizationId])
}

model Proposal {
  id                    String          @id @default(cuid())
  organizationId        String
  organization          Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  surveyId              String          @unique
  survey                SiteSurvey      @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  // Client reference
  clientName            String
  clientEmail           String?

  // Template & content
  templateName          String          // Quick Quote, Consultative, Authority
  sections              ProposalSection[]
  pricingLineItems      PricingLineItem[]

  // Metadata
  status                ProposalStatus  @default(DRAFT)
  sentAt                DateTime?

  // Sign-off workflow (for draft-only surveyors — see User.canSendProposals)
  approvalStatus        ApprovalStatus  @default(NONE)
  submittedById         String?         // who sent it for review
  submittedAt           DateTime?
  reviewedById          String?         // approver who approved / requested changes
  reviewedAt            DateTime?
  reviewNote            String?         // approver's note when requesting changes

  generationMs          Int? // how long the AI draft took - proves the tagline

  createdById           String?
  createdBy             User?           @relation("ProposalCreator", fields: [createdById], references: [id], onDelete: SetNull)

  // Per-proposal identity override (null = inherit the org default). See
  // lib/proposal-identity.ts. Same values as Organization.proposalIdentityMode.
  identityMode          String?
  identityUserId        String?

  // Deposit
  depositAmount         Float?
  depositPaidAt         DateTime?
  stripeSessionId       String?

  // Client acceptance
  signedAt              DateTime?
  signedName            String?
  signedPosition        String?
  signedCompany         String?
  signatureImage        String? // data URL of drawn signature
  selectedOptionalIds   String? // JSON array of PricingLineItem IDs the client chose at sign time
  agreedTotal           Float?  // total (inc VAT) the client signed for = base + selected optionals
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  shareLinks            ShareLink[]
  views                 ProposalView[]

  @@index([organizationId])
  @@index([status])
}

// One record per client viewing session (anonymous). Tracks how long the client
// spent reading and which sections held their attention.
model ProposalView {
  id                    String          @id @default(cuid())
  proposalId            String
  proposal              Proposal        @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  sessionId             String          @unique // client-generated per page load
  totalSeconds          Int             @default(0)
  sections              String? // JSON: [{ title, seconds }]

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([proposalId])
}

model ShareLink {
  id                    String          @id @default(cuid())
  proposalId            String
  proposal              Proposal        @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  token                 String          @unique // unguessable, generated with crypto
  expiresAt             DateTime
  revoked               Boolean         @default(false)
  viewCount             Int             @default(0)
  lastViewedAt          DateTime?

  createdAt             DateTime        @default(now())

  @@index([proposalId])
}

// Risk Assessment + Method Statement, drafted by AI from the survey and reviewed
// by the user. One per job (survey). All content is an editable DRAFT.
model Rams {
  id                    String          @id @default(cuid())
  organizationId        String
  organization          Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  surveyId              String          @unique
  survey                SiteSurvey      @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  hazards               String? // JSON: [{ hazard, whoAtRisk, controls, ppe }]
  methodStatement       String? // JSON: [step, step, ...]
  ppe                   String? // JSON: [string]
  siteInfo              String? // access / welfare / emergency notes (text)
  // JSON: the extended RAMS sections that match LBC's real document format:
  // { activity, scopeOfWorks, numOperatives, siteSupervisor, emergencyContacts,
  //   descriptionOfWorks, responsibilities[], equipment[], environmentalControls[],
  //   emergencyProcedures[], coshh[], competency[],
  //   operatives: [{ id, name, phone, email, signatureImage?, signedAt? }] }
  sections              String?
  // Public token for the no-login operative view + signing link (WhatsApp/email).
  publicToken           String?         @unique

  generationMs          Int?
  createdById           String?
  createdBy             User?           @relation("RamsCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([organizationId])
}

enum ProposalStatus {
  DRAFT
  READY
  SENT
  SIGNED
  DEPOSIT_PAID
  WON
  LOST
}

model ProposalSection {
  id                    String          @id @default(cuid())
  proposalId            String
  proposal              Proposal        @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  type                  String          // Cover, Scope, Photos, Pricing, etc
  title                 String
  content               String          // Markdown or structured data
  order                 Int
  isEditable            Boolean         @default(true)

  photoIds              String? // JSON array of photo IDs to include

  updatedAt             DateTime        @updatedAt

  @@index([proposalId])
}

model PricingLineItem {
  id                    String          @id @default(cuid())
  proposalId            String
  proposal              Proposal        @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  description           String
  quantity              Float
  unit                  String          // e.g., "hours", "sqft", "each"
  unitPrice             Float
  vat                   Float           @default(0)
  discount              Float           @default(0)
  isOptional            Boolean         @default(false)

  order                 Int             @default(0)

  @@index([proposalId])
}

// In-app beta feedback from users (stored + emailed to the SurvAIPro team).
model Feedback {
  id                    String          @id @default(cuid())
  organizationId        String
  userId                String?
  userEmail             String?
  companyName           String?
  isFoundingMember      Boolean         @default(false)
  message               String
  context               String?         // page path the feedback was sent from
  createdAt             DateTime        @default(now())

  @@index([organizationId])
}

// One-off (or limited-use) free-access codes issued by the platform for testers.
model AccessCode {
  id                    String          @id @default(cuid())
  code                  String          @unique
  label                 String?         // who it's for / note
  active                Boolean         @default(true)
  maxUses               Int             @default(1)
  uses                  Int             @default(0)
  createdAt             DateTime        @default(now())
}
